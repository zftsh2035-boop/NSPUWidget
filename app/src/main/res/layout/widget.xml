<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/panel" android:padding="13dp" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/header" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Расписание НГПУ" android:textColor="#FFFFFF"
            android:textStyle="bold" android:textSize="16sp" android:maxLines="1" />
        <TextView android:id="@+id/prev" android:layout_width="39dp" android:layout_height="43dp"
            android:gravity="center" android:text="‹" android:textColor="#C6DAFF" android:textSize="27sp"
            android:contentDescription="Предыдущий день" />
        <TextView android:id="@+id/next" android:layout_width="39dp" android:layout_height="43dp"
            android:gravity="center" android:text="›" android:textColor="#C6DAFF" android:textSize="27sp"
            android:contentDescription="Следующий день" />
    </LinearLayout>

    <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Загрузка…" android:textColor="#A9BFD5" android:textSize="12sp" android:paddingBottom="6dp" />

    <LinearLayout android:id="@+id/noticeBox" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:background="@drawable/notice_panel" android:padding="10dp" android:layout_marginBottom="8dp"
        android:visibility="gone" android:contentDescription="Открыть объявления НГПУ">
        <TextView android:id="@+id/noticeLabel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#FFD27A"
            android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/noticeText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#FFF3DA" android:textSize="12sp"
            android:maxLines="3" android:ellipsize="end" android:paddingTop="3dp" />
        <TextView android:id="@+id/noticeMeta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#C6AE8C"
            android:textSize="10sp" android:paddingTop="3dp" />
    </LinearLayout>

    <TextView android:id="@+id/lesson1" style="@style/Lesson" />
    <TextView android:id="@+id/lesson2" style="@style/Lesson" />
    <TextView android:id="@+id/lesson3" style="@style/Lesson" />
    <TextView android:id="@+id/lesson4" style="@style/Lesson" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="4dp">
        <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="#8DA6BF" android:textSize="10sp"
            android:maxLines="2" />
        <TextView android:id="@+id/today" android:layout_width="58dp" android:layout_height="40dp"
            android:gravity="center" android:text="Сегодня" android:textColor="#C6DAFF" android:textSize="11sp"
            android:contentDescription="Вернуться к сегодняшнему дню" />
        <TextView android:id="@+id/refresh" android:layout_width="41dp" android:layout_height="40dp"
            android:gravity="center" android:text="⟳" android:textColor="#80D7B0" android:textSize="25sp"
            android:contentDescription="Обновить расписание" />
    </LinearLayout>
</LinearLayout>
