<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/panel"
    android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/header" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF"
            android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/prev" android:layout_width="36dp"
            android:layout_height="44dp" android:gravity="center"
            android:text="‹" android:textColor="#BAE0FF" android:textSize="27sp"/>
        <TextView android:id="@+id/next" android:layout_width="36dp"
            android:layout_height="44dp" android:gravity="center"
            android:text="›" android:textColor="#BAE0FF" android:textSize="27sp"/>
    </LinearLayout>
    <TextView android:id="@+id/subtitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingBottom="8dp"
        android:textColor="#B4CCE9" android:textSize="11sp"
        android:maxLines="1" android:ellipsize="end"/>
    <LinearLayout android:id="@+id/noticeBox" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="@drawable/notice_panel"
        android:padding="9dp" android:orientation="vertical"
        android:layout_marginBottom="7dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:id="@+id/noticeLabel" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:textColor="#FFDC9C" android:textStyle="bold" android:textSize="10sp"/>
            <TextView android:id="@+id/noticeDismiss" android:layout_width="40dp"
                android:layout_height="36dp" android:text="✓" android:gravity="center"
                android:contentDescription="Скрыть объявление с виджета"
                android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="20sp"/>
        </LinearLayout>
        <TextView android:id="@+id/noticeText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#FFF4E0"
            android:textSize="11sp" android:maxLines="2" android:ellipsize="end"
            android:layout_marginTop="2dp"/>
        <TextView android:id="@+id/noticeMeta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#E2C3A2"
            android:textSize="10sp" android:layout_marginTop="2dp"/>
    </LinearLayout>
    <TextView android:id="@+id/lessonCount" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#C6DBEF"
        android:textSize="11sp" android:paddingBottom="5dp" />
    <ListView android:id="@+id/lessonList" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:drawSelectorOnTop="false" android:cacheColorHint="#00000000"
        android:divider="@android:color/transparent" android:dividerHeight="7dp"
        android:scrollbars="vertical" android:fadingEdge="vertical"/>
    <TextView android:id="@+id/emptyState" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#C4D6EA"
        android:gravity="center" android:textSize="12sp" android:padding="16dp"
        android:text="На этот день занятий нет"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/status" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#9BB3CD" android:textSize="10sp" android:maxLines="2"/>
        <TextView android:id="@+id/today" android:layout_width="63dp"
            android:layout_height="42dp" android:text="Сегодня"
            android:gravity="center" android:textSize="11sp" android:textColor="#C9DEFF"/>
        <TextView android:id="@+id/refresh" android:layout_width="34dp"
            android:layout_height="42dp" android:text="⟳" android:gravity="center"
            android:textSize="25sp" android:textColor="#5BE1B8"/>
    </LinearLayout>
</LinearLayout>