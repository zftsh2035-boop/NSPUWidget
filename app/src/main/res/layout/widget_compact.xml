<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/panel" android:padding="12dp" android:orientation="vertical"
    android:gravity="center_vertical">
    <TextView android:id="@+id/compactHeader" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="НГПУ · ближайшая пара"
        android:textColor="#B3D7FF" android:textSize="11sp" android:textStyle="bold"
        android:maxLines="1"/>
    <TextView android:id="@+id/compactSubject" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="7dp"
        android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
        android:ellipsize="end" android:maxLines="2"/>
    <TextView android:id="@+id/compactTeacher" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textColor="#D5E1F3" android:textSize="11sp" android:maxLines="1"
        android:ellipsize="end"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="8dp">
        <TextView android:id="@+id/compactTime" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
        <TextView android:id="@+id/compactKind" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginEnd="8dp"
            android:textColor="#6EDAC6" android:textSize="12sp" android:textStyle="bold"/>
        <TextView android:id="@+id/compactRoom" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#9DD9FF" android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>