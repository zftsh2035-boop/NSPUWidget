<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compactRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/panel"
    android:paddingStart="12dp" android:paddingEnd="12dp"
    android:paddingTop="10dp" android:paddingBottom="10dp"
     >
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="36dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/compactHeader" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:singleLine="true" android:ellipsize="end"
            android:text="НГПУ" android:textColor="#B3D7FF"
            android:textSize="11sp" android:textStyle="bold"/>
        <TextView android:id="@+id/compactKind" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:paddingStart="5dp" android:paddingEnd="5dp"
            android:paddingTop="3dp" android:paddingBottom="3dp"
            android:background="@drawable/compact_badge"
            android:textColor="#6EDAC6" android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:layout_marginEnd="30dp" android:id="@+id/compactSubject" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"
        android:ellipsize="end" android:maxLines="2"/>
    <TextView android:id="@+id/compactTime" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="5dp"
        android:textColor="#A9F2D9" android:textSize="12sp"
        android:textStyle="bold" android:singleLine="true" android:ellipsize="end"/>
    <TextView android:id="@+id/compactTeacher" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="3dp"
        android:textColor="#D5E1F3" android:textSize="11sp"
        android:singleLine="true" android:ellipsize="end"/>
    <TextView android:id="@+id/compactRoom" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="3dp"
        android:textColor="#9DD9FF" android:textSize="11sp"
        android:singleLine="true" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:id="@+id/groups" android:layout_width="36dp" android:layout_height="40dp"
        android:layout_gravity="top|end" android:gravity="center" android:text="☆" android:textSize="23sp"
        android:contentDescription="Избранные группы" />
</FrameLayout>
