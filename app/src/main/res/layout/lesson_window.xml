<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/windowCard"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/window_panel"
    android:paddingStart="12dp" android:paddingEnd="12dp"
    android:paddingTop="12dp" android:paddingBottom="12dp">
    <TextView android:layout_width="34dp" android:layout_height="wrap_content"
        android:text="☕" android:textSize="23sp" android:contentDescription="Свободное время"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/windowHeading" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#97F0D1"
            android:textSize="11sp" android:textStyle="bold" android:maxLines="1"/>
        <TextView android:id="@+id/windowMessage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#E1F6F0"
            android:textSize="12sp" android:layout_marginTop="4dp" android:maxLines="2"/>
    </LinearLayout>
</LinearLayout>