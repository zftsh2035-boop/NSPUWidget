<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lessonCard" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="horizontal"
    android:gravity="center_vertical" android:background="@drawable/lesson_panel"
    android:paddingEnd="9dp" android:paddingTop="9dp" android:paddingBottom="9dp">
    <TextView android:id="@+id/lessonStripe" android:layout_width="5dp"
        android:layout_height="68dp" android:background="#6DBEFF"/>
    <LinearLayout android:layout_width="64dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center"
        android:paddingStart="9dp" android:paddingEnd="3dp">
        <TextView android:id="@+id/lessonTimeStart" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="14sp"
            android:textStyle="bold" android:textColor="#FFFFFF"/>
        <TextView android:id="@+id/lessonTimeEnd" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="10sp"
            android:textColor="#B7CDE3" android:layout_marginTop="3dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/lessonKind" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textStyle="bold"
                android:textSize="11sp" android:textColor="#6DBEFF"/>
            <TextView android:id="@+id/lessonChanged" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="● ИЗМЕНЕНО" android:textColor="#FFC27C"
                android:textStyle="bold" android:textSize="9sp" android:visibility="gone"/>
        </LinearLayout>
        <TextView android:id="@+id/lessonState" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#C7ECFF"
            android:textSize="10sp" android:textStyle="bold" android:visibility="gone"
            android:layout_marginTop="3dp"/>
        <TextView android:id="@+id/lessonSubject" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#F9FCFF"
            android:textSize="13sp" android:textStyle="bold" android:maxLines="3"
            android:ellipsize="end" android:layout_marginTop="4dp"/>
        <TextView android:id="@+id/lessonTeacher" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#BFD0E5"
            android:textSize="11sp" android:maxLines="2"
            android:ellipsize="end" android:layout_marginTop="4dp"/>
        <TextView android:id="@+id/lessonNote" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="5dp"
            android:paddingTop="3dp" android:paddingBottom="3dp" android:textSize="12sp"
            android:maxLines="3" android:ellipsize="end" android:visibility="gone"/>
    </LinearLayout>
    <TextView android:id="@+id/lessonRoom" android:layout_width="62dp"
        android:layout_height="wrap_content" android:background="@drawable/room_panel"
        android:layout_marginStart="6dp" android:padding="6dp"
        android:gravity="center" android:textSize="11sp" android:textStyle="bold"
        android:textColor="#A4D7FF" android:maxLines="2"/>
</LinearLayout>
