<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/favoriteRow" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:minHeight="44dp" android:paddingHorizontal="8dp"
    android:paddingVertical="5dp" android:orientation="vertical" android:gravity="center_vertical">
    <TextView android:id="@+id/favoriteName" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/favoriteCode" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="10sp"
        android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
